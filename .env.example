# ─────────────────────────────────────────────────────────────
# VVI — Vendedor Virtual Inmobiliario · variables de entorno
# Copia este archivo a .env y completa los valores.
# NUNCA subas .env al repositorio (RNF-05).
# ─────────────────────────────────────────────────────────────

# --- Identidad del negocio ---
EMPRESA_NOMBRE="Inmobiliaria Demo"
POLITICA_PRIVACIDAD_URL="https://ejemplo.com/politica-de-tratamiento-de-datos"
COMISION_PCT=0.03

# --- Seguridad (RF-17, RNF-04) ---
# Genera las claves con:  python -m app.security.crypto
# Si las dejas vacías en desarrollo se generan al vuelo y NO persisten (los
# datos cifrados quedan ilegibles al reiniciar). En producción son obligatorias.
FERNET_KEY=
HMAC_KEY=

# --- Base de datos (ADR-04) ---
DATABASE_URL="sqlite:///./data/vvi.db"

# --- Canal Telegram (ADR-02) ---
# Token de @BotFather. Si se deja vacío, la app arranca sin bot (solo API/dashboard).
TELEGRAM_BOT_TOKEN=

# --- LLM de runtime (ADR-06) ---
# Proveedor primario: kimi | claude | reglas
LLM_PROVIDER=kimi
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL="https://api.moonshot.ai/v1"
MOONSHOT_MODEL="kimi-k2.6"
# Fallback configurable
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-opus-5"

# --- Dashboard del operador (HU-08) ---
DASHBOARD_USER=operador
DASHBOARD_PASSWORD=cambia-esta-clave
# En despliegue: la URL pública real. Alimenta los enlaces de campaña y los
# avisos al asesor; si queda en localhost, esos enlaces no le sirven a nadie.
DASHBOARD_URL="http://127.0.0.1:8000"
# Cuenta de solo lectura: ve la cartera y deja comentarios, no modifica nada y
# no alcanza prospectos ni auditoría. Con la clave vacía queda deshabilitada.
INVITADO_USER=invitado
INVITADO_PASSWORD=

# --- Despliegue (Railway u otra plataforma con volumen) ---
# Ambas rutas deben caer DENTRO del volumen persistente, o cada despliegue
# borra la base de datos y las fotos de los propietarios.
#   DATABASE_URL="sqlite:////data/vvi.db"
#   FOTOS_DIR="/data/fotos"
# HOST=0.0.0.0 lo pone el startCommand; el puerto llega en $PORT.
FOTOS_DIR=

# --- Aviso al asesor cuando entra una solicitud (RF-12) ---
NOTIFICACIONES_ACTIVAS=true
# Telegram no permite dirigirse a alguien por correo ni por usuario: hace falta
# el chat_id. El asesor le escribe /chatid al bot y pega aquí el número.
ASESOR_TELEGRAM_CHAT_ID=
ASESOR_EMAIL=
# SMTP para el aviso por correo. Sin SMTP_HOST el correo se omite en silencio.
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=
SMTP_TLS=true

# --- Captación opt-in en redes (RF-03, Fase 2) ---
META_VERIFY_TOKEN="cambia-este-token"
MERCADOLIBRE_SHARED_SECRET=

# --- Cumplimiento ---
# Días de retención documentados (RNF-06)
RETENCION_DIAS=365
# Días sin avance antes de exigir cierre al operador (control de comisión)
DIAS_ALERTA_SEGUIMIENTO=7

# --- Control de comisión (PRD §10) ---
# Ventana de protección: días durante los cuales una venta de ese inmueble a ese
# comprador es atribuible aunque se cierre por fuera del sistema. Se congela al
# presentar el comprador, así que cambiar esto no toca las presentaciones ya
# hechas. Seis meses es lo habitual en corretaje; ajústalo a lo que diga tu
# contrato.
DIAS_PROTECCION=180
# A los cuántos días de la presentación se le pregunta al comprador si el
# negocio ya se cerró. De varios hitos vencidos a la vez se manda uno solo.
# Vacío desactiva el seguimiento. Un 0 pregunta de inmediato: sirve para probar
# el circuito sin esperar una semana.
DIAS_SEGUIMIENTO_COMPRADOR="7,21,45"
# Cada cuántos minutos revisa el proceso si hay preguntas por enviar. Con 0 la
# tarea no se levanta y el bot no le escribe a nadie por su cuenta.
INTERVALO_SEGUIMIENTO_MIN=60

# --- Canal WhatsApp vía Evolution API (ADR-02b, Fase 2) ---
# Evolution API corre como servicio aparte (Docker) y habla WhatsApp Web con
# Baileys. Con EVOLUTION_URL vacío el canal no se monta y la app arranca igual.
# ADVERTENCIA: la integración Baileys NO es oficial. Usar un número dedicado,
# nunca el corporativo, y solo responder a quien escribe primero.
EVOLUTION_URL="http://localhost:8080"
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=vvi
# Segmento secreto de la ruta del webhook. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# El webhook queda en:  {base}/webhooks/whatsapp/{EVOLUTION_WEBHOOK_TOKEN}
EVOLUTION_WEBHOOK_TOKEN=
# De dónde cuelga ese webhook. Vacío = DASHBOARD_URL. Con Evolution en Docker
# y VVI en el host, `localhost` desde el contenedor es el propio contenedor:
#   EVOLUTION_WEBHOOK_BASE="http://host.docker.internal:8000"
EVOLUTION_WEBHOOK_BASE=
# Pausa de "escribiendo…" antes de responder, en milisegundos.
EVOLUTION_DELAY_MS=1200
# LISTA BLANCA DE PRUEBAS. Con al menos un número, el bot SOLO responde a esos
# y calla ante cualquier otro. Imprescindible si vinculas un número personal:
# sin esto, todo el que te escriba recibe el flujo del bot.
# Esto es solo el valor de arranque: la lista se cambia desde el dashboard, en
# Canal WhatsApp → «Números de prueba», y desde que se guarda ahí manda la de la
# base de datos. Un celular colombiano se puede escribir sin indicativo.
#   EVOLUTION_NUMEROS_PRUEBA="573001234567,573109876543"
EVOLUTION_NUMEROS_PRUEBA=
